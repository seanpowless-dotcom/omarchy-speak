#!/usr/bin/env python3
"""omarchy-speak — a small local TTS daemon for Omarchy.

Speaks the primary selection, the clipboard, or arbitrary text through a
configurable engine (piper for speed, kokoro for quality). Clips can be queued
and played in turn, paused mid-word and resumed, or stepped through forwards
and back. Exposes a tiny HTTP API on loopback so any client — Hyprland
keybinds, a status-bar widget, a browser extension — can drive the same
backend.

Stdlib only. No runtime dependencies beyond the TTS engines themselves.
"""

from __future__ import annotations

import errno
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

SCRATCH = Path(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp")
) / "omarchy-speak"

CONFIG_PATH = Path(
    os.environ.get("OMARCHY_SPEAK_CONFIG", "~/.config/omarchy-speak/config.json")
).expanduser()

DEFAULT_CONFIG = {
    "host": "127.0.0.1",
    "port": 8765,
    "default_engine": "piper",
    "save_dir": "~/Audio/speak",
    # True: ask where to save. False: write straight to save_dir.
    "save_prompt": True,
    # Speaking the selection falls back to the clipboard when no selection
    # exists. See SelectionFallback for why, and for what stops it speaking
    # something an hour old. False restricts /speak/selection to the primary
    # selection and nothing else.
    "selection_fallback": True,
    "max_chars": 20000,
    "engines": {
        # mode "stream": engine writes raw audio to stdout, piped straight to
        # the player. Lowest latency — speech starts before synthesis ends.
        "piper": {
            "mode": "stream",
            "speak": ["piper", "--model", "{model}", "--output-raw"],
            "save": ["piper", "--model", "{model}", "--output-file", "{out}"],
            "play": ["aplay", "-q", "-r", "22050", "-f", "S16_LE", "-t", "raw", "-"],
            "model": "",
        },
        # mode "file": engine renders a wav, then we play it. Higher latency,
        # but works with engines that have no streaming path.
        "kokoro": {
            "mode": "stream",
            "voice": "af_sarah",
            # Loads a model before the first sample, so it needs more headroom
            # than piper's default. This is headroom for a CPU-only machine, not
            # a measurement: on CUDA the same clip starts in 0.56s. If kokoro
            # blocks for longer than this at near-zero CPU, the warm worker has
            # wedged rather than gone slow -- restart omarchy-speak-kokoro.
            "startup_grace": 60,
            "speak": ["omarchy-speak-kokoro", "--voice", "{voice}", "--output-raw"],
            "save": ["omarchy-speak-kokoro", "--voice", "{voice}", "--output-file", "{out}"],
            "play": ["aplay", "-q", "-r", "24000", "-f", "S16_LE", "-t", "raw", "-"],
        },
    },
}


def log(msg: str) -> None:
    """One line to stderr, which under systemd is the journal."""
    print(f"omarchy-speak: {msg}", file=sys.stderr, flush=True)


# Playback watchdog. Speech runs about 12-16 characters a second, so a clip
# still sounding after several times its own length is not slow, it is stuck --
# almost always on an audio sink that accepts data and never drains it. A
# Bluetooth speaker that is connected but asleep looks exactly like this: BlueZ
# reports the device connected, PipeWire keeps the node alive, short writes
# vanish into the buffer and long ones block forever.
#
# Before this existed the watcher thread simply blocked in wait() for as long as
# the sink stayed wedged. One observed hang ran 756 seconds on a single
# paragraph, with /status reporting "speaking" the whole time and every
# subsequent keypress appearing dead.
#
# The budget is deliberately loose -- roughly three times real speech -- so a
# genuinely long article is never truncated. A 20,000 character read gets about
# 84 minutes before the watchdog looks at it.
STALL_CHARS_PER_SECOND = 4.0

# The grace covers everything before the first sample: process spawn, model
# load, and the engine's own warm-up. It is PER ENGINE because a model-loading
# engine on a slow machine can take far longer to first sample than a streaming
# one, and that says nothing about whether it is stuck.
#
# Resist the temptation to make it large. A long grace does not protect healthy
# playback -- it only delays noticing a broken engine. Measured on a machine
# with CUDA, kokoro produces a 43-character clip in 0.56s; the same request
# against a warm worker that had wedged blocked for over 180s at ~0% CPU. No
# grace distinguishes those two, so the grace should be sized for a slow
# machine's model load and nothing more.
DEFAULT_STARTUP_GRACE = 30.0


def stall_budget(text: str, spec: dict) -> float:
    """How long this clip may sound before it is presumed stuck.

    Startup grace comes from the engine spec, because a model-loading engine on
    a CPU is slow to first sample in a way that says nothing about whether it is
    stuck.
    """
    try:
        grace = float(spec.get("startup_grace", DEFAULT_STARTUP_GRACE))
    except (TypeError, ValueError):
        grace = DEFAULT_STARTUP_GRACE
    return max(grace, 1.0) + len(text) / STALL_CHARS_PER_SECOND


class ErrorTail:
    """Keeps the last few KB of a child's stderr without letting it block.

    A PIPE nobody reads fills at around 64K and the child blocks writing to it,
    so the choice is between discarding stderr and draining it. Both the engine
    and the player used DEVNULL, which meant a failure left nothing behind at
    all: through an entire playback outage the journal held only the daemon's
    own start and stop lines, and the cause had to be found by listing
    processes by hand. Draining costs one thread per child and makes the
    difference between a diagnosis and a guess.
    """

    LIMIT = 4000

    def __init__(self, proc: subprocess.Popen, name: str) -> None:
        self.name = name
        self._buf = bytearray()
        self._lock = threading.Lock()
        if proc.stderr is not None:
            threading.Thread(target=self._read, args=(proc.stderr,),
                             daemon=True).start()

    def _read(self, stream) -> None:
        try:
            for chunk in iter(lambda: stream.read(4096), b""):
                with self._lock:
                    self._buf.extend(chunk)
                    if len(self._buf) > self.LIMIT:
                        del self._buf[: -self.LIMIT]
        except (OSError, ValueError):
            pass
        finally:
            try:
                stream.close()
            except (OSError, ValueError):
                pass

    def text(self) -> str:
        with self._lock:
            return self._buf.decode("utf-8", "replace").strip()


def describe_tails(tails: list) -> str:
    parts = [f"{t.name}: {t.text()}" for t in tails if t.text()]
    return " | ".join(parts)


def sweep_scratch() -> int:
    """Delete temp audio orphaned by a crash or a kill mid-playback.

    Playback normally unlinks its own file, but a SIGKILL leaves it behind.
    Sweeping at startup keeps that from accumulating across sessions.
    """
    if not SCRATCH.is_dir():
        return 0
    removed = 0
    for stale in SCRATCH.glob("speak-*.wav"):
        try:
            stale.unlink()
            removed += 1
        except OSError:
            pass
    return removed


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))  # deep copy
    if CONFIG_PATH.exists():
        user = json.loads(CONFIG_PATH.read_text())
        for key, val in user.items():
            if key == "engines" and isinstance(val, dict):
                for name, spec in val.items():
                    cfg["engines"].setdefault(name, {}).update(spec)
            else:
                cfg[key] = val
    return cfg


def write_default_config() -> Path:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
    return CONFIG_PATH


def read_selection(primary: bool) -> str:
    """Read the Wayland primary selection or clipboard.

    Empty string when nothing is set: wl-paste exits non-zero on an empty
    selection, which is a normal state here and not an error.
    """
    cmd = ["wl-paste", "--no-newline"]
    if primary:
        cmd.append("--primary")
    try:
        out = subprocess.run(cmd, capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"wl-paste failed: {exc}") from exc
    return out.stdout.decode("utf-8", "replace").strip()


class SelectionFallback:
    """Reads the selection, falling back to the clipboard when there is none.

    The primary selection is system-wide only for applications that leave the
    mouse to the terminal or the toolkit. A TUI that turns on mouse reporting
    takes the drag for itself -- herdr with `mouse_capture = true`, tmux with
    `set -g mouse on`, nvim with `mouse=a` -- so the compositor never sees a
    selection at all and `wl-paste --primary` returns whatever some other
    window last set, or nothing.

    Those applications do still copy. They copy with OSC 52, whose target is
    the clipboard rather than the primary selection: herdr emits `]52;c` and
    contains no `]52;p` anywhere. So an empty primary selection is the signal
    that we are inside such an application, and the clipboard is where its
    copy actually went.

    The risk of falling back is speaking something stale, because "nothing is
    selected" and "nothing was selected but something was copied an hour ago"
    look identical from here. Two things bound it:

      - the fallback runs only when the primary selection is EMPTY, so it can
        never override a real selection; and
      - the same clipboard text is never handed out twice, so holding the key
        down in a terminal that sets no selection reads the clipboard once and
        then reports nothing to speak, instead of repeating an hour-old copy.

    Asking for the clipboard BY NAME is not a fallback and is not guarded:
    /speak/clipboard always speaks it, however recently it was last spoken.
    That is the way to deliberately repeat something.
    """

    def __init__(self, enabled: bool = True):
        self.enabled = enabled
        # The last text the fallback handed out -- not the last text spoken.
        # Requests are served on threads, so it is locked.
        self._last: str | None = None
        self._lock = threading.Lock()

    def read(self, source: str) -> tuple[str, str]:
        """Returns the text and the source it actually came from.

        The second value differs from `source` exactly when the fallback
        fired, which is the only way a caller can tell that it did.
        """
        if source != "primary":
            return read_selection(primary=False), source

        text = read_selection(primary=True)
        if text:
            return text, "primary"
        if not self.enabled:
            return "", "primary"

        clipboard = read_selection(primary=False)
        if not clipboard:
            return "", "primary"
        with self._lock:
            if clipboard == self._last:
                return "", "primary"
            self._last = clipboard
        return clipboard, "clipboard"


def render(template: list[str], **fields) -> list[str]:
    """Substitute {placeholders} and expand a leading ~ in the result.

    Config files carry paths like ~/.local/share/piper/voices/x.onnx; the
    engine subprocess gets no shell, so the tilde must be expanded here.
    """
    parts = []
    for part in template:
        value = part.format(**fields)
        if value.startswith("~"):
            value = str(Path(value).expanduser())
        parts.append(value)
    return parts


class Clip:
    """One queued utterance."""

    __slots__ = ("text", "engine", "spec")

    def __init__(self, text: str, engine: str, spec: dict) -> None:
        self.text, self.engine, self.spec = text, engine, spec

    @property
    def label(self) -> str:
        """A one-line preview, for /status and /queue."""
        flat = " ".join(self.text.split())
        return flat[:60] + ("…" if len(flat) > 60 else "")


class Player:
    """Queue-driven playback: one clip sounds, the rest wait their turn.

    Pause suspends the process chain with SIGSTOP rather than tearing it down,
    so resuming continues mid-word instead of restarting the clip. The
    synthesiser needs no separate handling — once the player stops draining the
    pipe, it blocks on a full buffer by itself.
    """

    RESTART_WINDOW = 3.0  # seconds into a clip after which "back" restarts it

    def __init__(self) -> None:
        self._lock = threading.RLock()
        self._procs: list[subprocess.Popen] = []
        self._tmp: Path | None = None  # file-mode scratch, removed after playback
        self._queue: list[Clip] = []
        self._index = -1               # position in _queue; -1 when idle
        self._paused = False
        self._gen = 0                  # retires the watcher of a superseded clip
        self._started = 0.0
        self._paused_at = 0.0
        self._paused_for = 0.0

    # -- state ------------------------------------------------------------
    def _running(self) -> bool:
        return any(p.poll() is None for p in self._procs)

    @property
    def busy(self) -> bool:
        with self._lock:
            return self._running()

    def _elapsed(self) -> float:
        held = self._paused_for
        if self._paused:
            held += time.time() - self._paused_at
        return max(0.0, time.time() - self._started - held)

    def _current(self) -> Clip | None:
        if 0 <= self._index < len(self._queue):
            return self._queue[self._index]
        return None

    def status(self) -> dict:
        with self._lock:
            live = self._running()
            clip = self._current() if live else None
            return {
                "speaking": live and not self._paused,
                "paused": live and self._paused,
                "engine": clip.engine if clip else None,
                "elapsed": round(self._elapsed(), 2) if live else 0,
                "index": self._index if live else -1,
                "queued": len(self._queue),
                "current": clip.label if clip else None,
            }

    def queue(self) -> dict:
        with self._lock:
            return {
                "index": self._index,
                "items": [
                    {"n": i, "engine": c.engine, "text": c.label,
                     "current": i == self._index}
                    for i, c in enumerate(self._queue)
                ],
            }

    # -- transport --------------------------------------------------------
    @staticmethod
    def _signal(proc: subprocess.Popen, sig: int) -> None:
        try:
            if proc.poll() is None:
                proc.send_signal(sig)
        except OSError:
            pass

    def _teardown(self) -> bool:
        """Kill the current chain, leaving the queue alone. Caller holds the lock."""
        was_running = self._running()
        if self._paused:
            # A SIGSTOPped process never gets to act on SIGTERM. Wake it first.
            for proc in self._procs:
                self._signal(proc, signal.SIGCONT)
            self._paused = False
        for proc in reversed(self._procs):
            if proc.poll() is None:
                proc.terminate()
        deadline = time.time() + 2
        for proc in self._procs:
            try:
                proc.wait(timeout=max(0, deadline - time.time()))
            except subprocess.TimeoutExpired:
                proc.kill()
        self._procs = []
        if self._tmp is not None:
            self._tmp.unlink(missing_ok=True)
            self._tmp = None
        return was_running

    def stop(self) -> bool:
        """Hard stop: silence playback and forget the queue."""
        with self._lock:
            self._gen += 1
            was_running = self._teardown()
            self._queue = []
            self._index = -1
            return was_running

    def _play(self, i: int) -> bool:
        with self._lock:
            if not 0 <= i < len(self._queue):
                return False
            clip = self._queue[i]
            self._gen += 1
            gen = self._gen
            self._teardown()

        # A file-mode engine synthesises here, which can take seconds — so it
        # runs outside the lock, keeping /status answerable throughout.
        spec = clip.spec
        spawn = (self._spawn_stream if spec.get("mode", "stream") == "stream"
                 else self._spawn_file)
        procs, tails = spawn(clip.text, spec)

        with self._lock:
            if gen != self._gen:  # superseded while we were synthesising
                for proc in reversed(procs):
                    if proc.poll() is None:
                        proc.terminate()
                return False
            self._procs = procs
            self._index = i
            self._paused = False
            self._started = time.time()
            self._paused_for = 0.0
        threading.Thread(
            target=self._watch,
            args=(gen, procs[-1], stall_budget(clip.text, spec), tails),
            daemon=True,
        ).start()
        return True

    def _watch(self, gen: int, play: subprocess.Popen, budget: float,
               tails: list[ErrorTail]) -> None:
        """Advance the queue when a clip ends of its own accord.

        Polls rather than blocking in wait(), so a clip that never ends can be
        cut loose instead of parking this thread for as long as the audio sink
        stays wedged.

        Paused time does not count against the budget. _elapsed() already
        excludes it, and a SIGSTOPped child is *meant* to park here
        indefinitely — pausing a clip over lunch must not look like a stall.
        """
        while True:
            try:
                play.wait(timeout=1.0)
                break
            except subprocess.TimeoutExpired:
                with self._lock:
                    if gen != self._gen:
                        return  # stopped, skipped or replaced — not ours any more
                    if self._paused or self._elapsed() <= budget:
                        continue
                    overran = self._elapsed()
                self._stalled(gen, overran, budget, tails)
                return

        with self._lock:
            if gen != self._gen:
                return  # stopped, skipped, or replaced — no longer ours to advance
            # A player that died on its own says why, now that stderr is kept.
            if play.returncode not in (0, None):
                detail = describe_tails(tails)
                log(f"player exited {play.returncode}"
                    + (f": {detail}" if detail else " with no stderr"))
            nxt = self._index + 1
            if nxt >= len(self._queue):
                self._procs = []
                self._index = -1
                # Drop the played clip. next() and prev() are both gated on
                # _index, which is -1 from here, so a retained clip is
                # unreachable — it only inflated "queued" in /status and left
                # /queue listing something that had already finished.
                self._queue = []
                return
        self._play(nxt)

    def _stalled(self, gen: int, elapsed: float, budget: float,
                 tails: list[ErrorTail]) -> None:
        """Kill a clip that has outlived any plausible duration, and say why.

        The queue is dropped rather than advanced: whatever wedged this clip is
        a property of the audio sink, not of the text, so the next clip would
        almost certainly wedge in the same place.
        """
        with self._lock:
            if gen != self._gen:
                return
            self._gen += 1
            self._teardown()
            self._queue = []
            self._index = -1
        detail = describe_tails(tails)
        log(f"playback stalled after {elapsed:.0f}s (budget {budget:.0f}s) and was "
            f"killed. The audio sink is accepting audio without draining it — a "
            f"Bluetooth speaker that is connected but asleep does exactly this. "
            f"Check `wpctl status` for the default sink."
            + (f" Child stderr: {detail}" if detail else " No stderr from either child."))

    def speak(self, text: str, engine: str, spec: dict) -> None:
        """Replace the queue with this one clip and play it."""
        with self._lock:
            self._gen += 1
            self._teardown()
            self._queue = [Clip(text, engine, spec)]
            self._index = -1
        self._play(0)

    def enqueue(self, clip: Clip) -> dict:
        """Append to the queue, starting playback if nothing is sounding."""
        with self._lock:
            self._queue.append(clip)
            position = len(self._queue) - 1
            idle = not self._running()
        if idle:
            self._play(position)
        return {"position": position, "queued": position + 1, "started": idle}

    def clear(self) -> int:
        """Drop everything not currently playing."""
        with self._lock:
            clip = self._current()
            dropped = len(self._queue) - (1 if clip else 0)
            self._queue = [clip] if clip else []
            self._index = 0 if clip else -1
            return max(0, dropped)

    def next(self) -> bool:
        with self._lock:
            nxt = self._index + 1
            if not 0 <= nxt < len(self._queue):
                return False
        return self._play(nxt)

    def prev(self) -> bool:
        """Back one clip — or restart this one, if we are well into it."""
        with self._lock:
            if self._index < 0:
                return False
            target = self._index
            if self._elapsed() < self.RESTART_WINDOW:
                target = max(0, self._index - 1)
        return self._play(target)

    def pause(self) -> bool:
        with self._lock:
            if self._paused or not self._running():
                return False
            for proc in self._procs:
                self._signal(proc, signal.SIGSTOP)
            self._paused = True
            self._paused_at = time.time()
            return True

    def resume(self) -> bool:
        with self._lock:
            if not self._paused:
                return False
            for proc in self._procs:
                self._signal(proc, signal.SIGCONT)
            self._paused_for += time.time() - self._paused_at
            self._paused = False
            return True

    def _spawn_stream(self, text: str, spec: dict) -> tuple[list[subprocess.Popen], list[ErrorTail]]:
        tts_cmd = render(spec["speak"], **spec)
        play_cmd = render(spec["play"], **spec)
        tts = subprocess.Popen(
            tts_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        play = subprocess.Popen(
            play_cmd, stdin=tts.stdout, stderr=subprocess.PIPE,
        )
        tts.stdout.close()  # let the player own the read end
        tails = [ErrorTail(tts, tts_cmd[0]), ErrorTail(play, play_cmd[0])]

        def feed() -> None:
            try:
                tts.stdin.write(text.encode())
                tts.stdin.close()
            except (BrokenPipeError, ValueError):
                pass

        threading.Thread(target=feed, daemon=True).start()
        return [tts, play], tails

    def _spawn_file(self, text: str, spec: dict) -> tuple[list[subprocess.Popen], list[ErrorTail]]:
        tmp = SCRATCH / f"speak-{os.getpid()}-{int(time.time()*1000)}.wav"
        tmp.parent.mkdir(parents=True, exist_ok=True)
        # Same budget as playback, for the same reason: an engine that never
        # returns would otherwise park this thread forever. The watchdog only
        # covers the player, so a synchronous synthesis needs its own bound.
        budget = stall_budget(text, spec)
        try:
            synth = subprocess.run(
                render(spec["save"], out=str(tmp), **spec),
                input=text.encode(), capture_output=True, timeout=budget,
            )
        except subprocess.TimeoutExpired:
            tmp.unlink(missing_ok=True)
            raise RuntimeError(
                f"synthesis timed out after {budget:.0f}s. Raise startup_grace for "
                f"this engine if it is merely slow to load its model."
            ) from None
        if synth.returncode != 0 or not tmp.exists():
            tmp.unlink(missing_ok=True)  # a failed run may still have written bytes
            err = synth.stderr.decode("utf-8", "replace")[:400]
            raise RuntimeError(f"synthesis failed: {err or 'no output produced'}")
        play_cmd = render(spec["play"], out=str(tmp), **spec)
        play = subprocess.Popen(play_cmd, stderr=subprocess.PIPE)
        tails = [ErrorTail(play, play_cmd[0])]

        self._tmp = tmp

        def cleanup() -> None:
            play.wait()
            tmp.unlink(missing_ok=True)

        threading.Thread(target=cleanup, daemon=True).start()
        return [play], tails


class Handler(BaseHTTPRequestHandler):
    server_version = "omarchy-speak"
    protocol_version = "HTTP/1.1"

    # -- plumbing ---------------------------------------------------------
    def log_message(self, fmt, *args):  # quieter than the stdlib default
        if self.server.verbose:
            sys.stderr.write(f"{self.address_string()} {fmt % args}\n")

    def _send(self, code: int, payload: dict) -> None:
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self) -> dict:
        length = int(self.headers.get("Content-Length") or 0)
        if not length:
            return {}
        try:
            return json.loads(self.rfile.read(length))
        except json.JSONDecodeError:
            return {}

    # -- routes -----------------------------------------------------------
    def do_GET(self):
        if self.path in ("/health", "/status"):
            self._send(200, {"ok": True, **self.server.player.status()})
        elif self.path == "/config":
            cfg = self.server.config
            self._send(200, {
                "save_dir": cfg["save_dir"],
                "save_prompt": cfg.get("save_prompt", True),
                "selection_fallback": self.server.selection.enabled,
                "default_engine": cfg["default_engine"],
            })
        elif self.path == "/engines":
            cfg = self.server.config
            self._send(200, {
                "default": cfg["default_engine"],
                "engines": sorted(cfg["engines"]),
            })
        elif self.path == "/queue":
            self._send(200, {"ok": True, **self.server.player.queue()})
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        routes = {
            "/speak": self._speak,
            "/speak/selection": lambda b: self._speak(b, source="primary"),
            "/speak/clipboard": lambda b: self._speak(b, source="clipboard"),
            "/queue": self._enqueue,
            "/queue/selection": lambda b: self._enqueue(b, source="primary"),
            "/queue/clipboard": lambda b: self._enqueue(b, source="clipboard"),
            "/queue/clear": self._clear,
            "/save": self._save,
            "/stop": self._stop,
            "/toggle": self._toggle,
            "/playpause": self._playpause,
            "/pause": self._pause,
            "/resume": self._resume,
            "/next": self._next,
            "/prev": self._prev,
        }
        handler = routes.get(self.path)
        if not handler:
            self._send(404, {"error": "not found"})
            return
        try:
            handler(self._body())
        except RuntimeError as exc:
            self._send(400, {"error": str(exc)})
        except Exception as exc:  # noqa: BLE001 - surface it, don't crash the daemon
            self._send(500, {"error": f"{type(exc).__name__}: {exc}"})

    # -- actions ----------------------------------------------------------
    def _resolve(self, body: dict, source: str | None) -> tuple[str, str, dict, str]:
        cfg = self.server.config
        used = source or "text"
        if source:
            text, used = self.server.selection.read(source)
        else:
            text = (body.get("text") or "").strip()
        if not text:
            raise RuntimeError(self._nothing_to_speak(source))
        text = text[: cfg["max_chars"]]

        engine = body.get("engine") or cfg["default_engine"]
        spec = cfg["engines"].get(engine)
        if spec is None:
            raise RuntimeError(f"unknown engine {engine!r}")
        missing = self._missing_binaries(spec)
        if missing:
            raise RuntimeError(f"{engine}: missing binaries: {', '.join(missing)}")
        return text, engine, spec, used

    def _nothing_to_speak(self, source: str | None) -> str:
        """Says what to do about it, not just that it happened.

        An empty primary selection is the one failure here with a non-obvious
        cause, and it is the common one: a mouse-capturing TUI never sets a
        selection, so this reads as "the keybind is broken" rather than as
        "there is nothing selected". Name the cause in the message, because
        the journal is where anyone will look first.
        """
        if source == "primary":
            if not self.server.selection.enabled:
                return ("nothing to speak: no primary selection, and "
                        "selection_fallback is off")
            return (
                "nothing to speak: no primary selection, and the clipboard "
                "held nothing new. A terminal application that captures the "
                "mouse (herdr, tmux, nvim) sets no selection -- hold Shift "
                "while dragging to select with the terminal instead, or copy "
                "and use /speak/clipboard."
            )
        return f"nothing to speak ({source or 'text'} was empty)"

    @staticmethod
    def _missing_binaries(spec: dict) -> list[str]:
        missing = []
        for key in ("speak", "save", "play"):
            cmd = spec.get(key)
            if cmd and shutil.which(cmd[0]) is None:
                missing.append(cmd[0])
        return sorted(set(missing))

    def _speak(self, body: dict, source: str | None = None) -> None:
        text, engine, spec, used = self._resolve(body, source)
        self.server.player.speak(text, engine, spec)
        self._send(200, {"ok": True, "engine": engine, "chars": len(text),
                         "source": used})

    def _save(self, body: dict) -> None:
        cfg = self.server.config
        text, engine, spec, used = self._resolve(body, body.get("source"))
        if "save" not in spec:
            raise RuntimeError(f"engine {engine!r} has no save command")

        dest = body.get("path")
        if dest:
            out = Path(dest).expanduser()
        else:
            stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
            out = Path(cfg["save_dir"]).expanduser() / f"speak-{stamp}.wav"
        out.parent.mkdir(parents=True, exist_ok=True)

        # /save renders without playing, so nothing is waiting to hear it and a
        # slow engine is a fine trade -- but "slow" still has to end. A wedged
        # engine here would hold this request open indefinitely.
        budget = stall_budget(text, spec)
        try:
            result = subprocess.run(
                render(spec["save"], out=str(out), **spec),
                input=text.encode(), capture_output=True, timeout=budget,
            )
        except subprocess.TimeoutExpired:
            out.unlink(missing_ok=True)
            raise RuntimeError(
                f"save timed out after {budget:.0f}s. Raise startup_grace for this "
                f"engine if it is merely slow to load its model."
            ) from None
        if result.returncode != 0 or not out.exists():
            err = result.stderr.decode("utf-8", "replace")[:400]
            raise RuntimeError(f"save failed: {err or 'no output produced'}")
        self._send(200, {"ok": True, "engine": engine, "path": str(out),
                         "bytes": out.stat().st_size, "source": used})

    def _stop(self, body: dict) -> None:
        self._send(200, {"ok": True, "stopped": self.server.player.stop()})

    def _toggle(self, body: dict) -> None:
        """Stop if speaking, otherwise speak the primary selection."""
        if self.server.player.stop():
            self._send(200, {"ok": True, "action": "stopped"})
            return
        text, engine, spec, used = self._resolve(body, "primary")
        self.server.player.speak(text, engine, spec)
        self._send(200, {"ok": True, "action": "speaking", "engine": engine,
                         "source": used})

    def _enqueue(self, body: dict, source: str | None = None) -> None:
        if source is None:
            # Literal text wins; otherwise queueing means the selection.
            source = body.get("source") or (None if body.get("text") else "primary")
        text, engine, spec, used = self._resolve(body, source)
        result = self.server.player.enqueue(Clip(text, engine, spec))
        self._send(200, {"ok": True, "engine": engine, "chars": len(text),
                         "source": used, **result})

    def _clear(self, body: dict) -> None:
        self._send(200, {"ok": True, "dropped": self.server.player.clear()})

    def _playpause(self, body: dict) -> None:
        """Resume, or pause, or — with nothing loaded — speak the selection."""
        player = self.server.player
        if player.resume():
            self._send(200, {"ok": True, "action": "resumed"})
            return
        if player.pause():
            self._send(200, {"ok": True, "action": "paused"})
            return
        text, engine, spec, used = self._resolve(body, "primary")
        player.speak(text, engine, spec)
        self._send(200, {"ok": True, "action": "speaking", "engine": engine,
                         "source": used})

    def _pause(self, body: dict) -> None:
        self._send(200, {"ok": True, "paused": self.server.player.pause()})

    def _resume(self, body: dict) -> None:
        self._send(200, {"ok": True, "resumed": self.server.player.resume()})

    def _next(self, body: dict) -> None:
        moved = self.server.player.next()
        self._send(200, {"ok": True, "moved": moved,
                         **self.server.player.status()})

    def _prev(self, body: dict) -> None:
        moved = self.server.player.prev()
        self._send(200, {"ok": True, "moved": moved,
                         **self.server.player.status()})


def main() -> int:
    args = sys.argv[1:]
    if "--init-config" in args:
        print(f"wrote {write_default_config()}")
        return 0
    if "--help" in args or "-h" in args:
        print(__doc__)
        print("usage: omarchy-speak [--init-config] [--verbose]")
        print(f"config: {CONFIG_PATH}")
        return 0

    cfg = load_config()
    try:
        server = ThreadingHTTPServer((cfg["host"], cfg["port"]), Handler)
    except OSError as exc:
        # Almost always "already running", which deserves a sentence rather
        # than a traceback -- it is the most likely first-run mistake.
        host, port = cfg["host"], cfg["port"]
        print(f"omarchy-speak: cannot bind {host}:{port} - {exc.strerror}",
              file=sys.stderr)
        if exc.errno == errno.EADDRINUSE:
            print("  Another omarchy-speak is probably already running:\n"
                  "    systemctl --user status omarchy-speak\n"
                  f"  Or change \"port\" in {CONFIG_PATH}", file=sys.stderr)
        return 1
    server.daemon_threads = True
    server.config = cfg
    server.player = Player()
    server.selection = SelectionFallback(cfg.get("selection_fallback", True))
    server.verbose = "--verbose" in args or "-v" in args

    def shutdown(signum, frame):
        server.player.stop()
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    swept = sweep_scratch()
    print(f"omarchy-speak on http://{cfg['host']}:{cfg['port']} "
          f"(engine: {cfg['default_engine']})"
          + (f" [swept {swept} stale temp files]" if swept else ""), flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
