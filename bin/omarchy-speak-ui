#!/usr/bin/env python3
"""omarchy-speak-ui — a small curses console for choosing a voice.

Arrows and the mouse both work. Language across the top, voices down the left,
the selected voice and speed on the right, and a level meter along the bottom.

The meter reads the OUTPUT SINK, not the synthesiser. That distinction is the
whole reason it exists: a meter fed from the engine bounces happily while a
Bluetooth speaker that is connected but asleep swallows every sample, which is a
failure that has cost real hours. Fed from the sink's monitor, a flat bar during
playback means no sound is reaching the world, and that is worth knowing.

Stdlib only, like the daemon. Talks to it over the same loopback HTTP the
keybinds use, and tests voices by driving the engine directly so that auditioning
one does not disturb whatever the daemon is doing.
"""

from __future__ import annotations

import curses
import json
import os
import re
import shutil
import struct
import subprocess
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

HOST = os.environ.get("OMARCHY_SPEAK_HOST", "127.0.0.1")
PORT = os.environ.get("OMARCHY_SPEAK_PORT", "8765")
BASE = f"http://{HOST}:{PORT}"

CONFIG = Path(os.environ.get("OMARCHY_SPEAK_CONFIG",
                             "~/.config/omarchy-speak/config.json")).expanduser()
CACHE = Path(os.environ.get("XDG_CACHE_HOME", "~/.cache")).expanduser() / "omarchy-speak"
VOICE_CACHE = CACHE / "voices.txt"

SAMPLE = "The quick brown fox jumps over the lazy dog."

# Chunk size is only observable on long text -- a single sentence is one chunk
# whatever the setting -- so tuning it needs a passage. The project README if
# one is to hand, since it is real prose with real paragraph structure;
# otherwise something generated, so the key always does something.
LONG_FALLBACK = (
    "The quick brown fox jumps over the lazy dog while the daemon renders audio. "
) * 8

CHUNK_MIN, CHUNK_MAX, CHUNK_STEP = 50, 500, 25

# Rows per wheel notch. One is what every list in every other application does,
# so it is the default; a high-resolution or free-spinning wheel may want more.
# Set "ui": {"scroll_lines": N} in the config to change it.
DEFAULT_SCROLL_LINES = 1


def long_sample() -> str:
    for candidate in (Path.home() / "omarchy-speak/README.md",
                      Path("/usr/share/doc/omarchy-speak/README.md")):
        try:
            text = candidate.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        # Light markdown strip. Not the full treatment `omarchy-speak-ctl read`
        # gives a document -- this is a test tone, not a reader -- but enough
        # that the sample does not audition as "hash omarchy dash speak, bracket
        # Omarchy bracket paren h t t p s", which would demonstrate the bug
        # rather than the voice.
        text = re.sub(r"```.*?```", " ", text, flags=re.S)
        text = re.sub(r"!\[[^\]]*\]\([^)]*\)", " ", text)
        text = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", text)
        text = re.sub(r"[#*_`>|]", " ", text)
        # Enough to exercise several chunks without reading the whole manual.
        flat = " ".join(text.split())
        if len(flat) > 400:
            return flat[:2500]
    return LONG_FALLBACK.strip()

# Kokoro encodes language and gender in the voice name: first letter language,
# second gender. Nothing else about a voice is knowable without hearing it,
# which is why this has a test key and no written descriptions.
LANGS = {
    "a": "American", "b": "British", "e": "Spanish", "f": "French",
    "h": "Hindi", "i": "Italian", "j": "Japanese", "p": "Portuguese",
    "z": "Chinese",
}
GENDER = {"f": "female", "m": "male"}


# ── data ────────────────────────────────────────────────────────────────────
def http(method: str, path: str, body: dict | None = None, timeout: float = 10):
    req = urllib.request.Request(
        BASE + path, method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Content-Type": "application/json"} if body is not None else {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def load_voices(refresh: bool = False) -> list[str]:
    """Voice names, cached because listing them loads the model.

    The list is a property of the model file, so it only changes when that does.
    """
    if not refresh and VOICE_CACHE.is_file():
        names = [x.strip() for x in VOICE_CACHE.read_text().splitlines() if x.strip()]
        if names:
            return names
    out = subprocess.run(["omarchy-speak-kokoro", "--list-voices"],
                         capture_output=True, text=True, timeout=180)
    names = [l.strip() for l in out.stdout.splitlines()
             if l.strip() and "_" in l and " " not in l.strip()]
    if names:
        CACHE.mkdir(parents=True, exist_ok=True)
        VOICE_CACHE.write_text("\n".join(names) + "\n")
    return names


def describe(voice: str) -> str:
    prefix = voice.split("_")[0] if "_" in voice else ""
    if len(prefix) == 2:
        return f"{LANGS.get(prefix[0], '?')} {GENDER.get(prefix[1], '')}".strip()
    return ""


def ctl_supports(verb: str) -> bool:
    """Whether the installed omarchy-speak-ctl knows a verb."""
    try:
        out = subprocess.run(["omarchy-speak-ctl", "--help"],
                             capture_output=True, text=True, timeout=10)
        return any(line.strip().startswith(verb) for line in out.stdout.splitlines())
    except (OSError, subprocess.SubprocessError):
        return False


def read_config() -> dict:
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


# A setting only reaches the engine if the command template mentions it:
# render() substitutes {placeholders} from the engine block, so a key the
# template never names is written, reported as saved, and silently ignored.
# Configs written before these flags existed are exactly in that state.
TEMPLATE_FLAGS = {"speed": "--speed", "chunk_chars": "--chunk-chars"}


def ensure_template_uses(engine: dict, key: str) -> bool:
    """Add the flag for `key` to this engine's commands if it is missing.

    Returns whether anything changed. Only touches commands that already
    invoke omarchy-speak-kokoro, so a hand-written template for some other
    binary is left alone.
    """
    flag = TEMPLATE_FLAGS.get(key)
    if not flag:
        return False
    changed = False
    for name in ("speak", "save"):
        cmd = engine.get(name)
        if not isinstance(cmd, list) or not cmd:
            continue
        if "omarchy-speak-kokoro" not in cmd[0]:
            continue
        if any(flag == arg for arg in cmd):
            continue
        # Before the trailing output flag, so the command reads naturally.
        insert = len(cmd)
        for i, arg in enumerate(cmd):
            if arg.startswith("--output"):
                insert = i
                break
        cmd[insert:insert] = [flag, "{" + key + "}"]
        changed = True
    return changed


def write_engine_setting(key: str, value) -> tuple[bool, bool]:
    """Persist one kokoro setting, leaving the rest of the file alone.

    Returns (written, template_repaired).
    """
    cfg = read_config()
    engine = cfg.setdefault("engines", {}).setdefault("kokoro", {})
    engine[key] = value
    repaired = ensure_template_uses(engine, key)
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(cfg, indent=2) + "\n")
    return True, repaired


# ── level meter ─────────────────────────────────────────────────────────────
class Meter:
    """RMS of the default sink's monitor, 0.0-1.0, updated in a thread.

    Reads the sink rather than the engine deliberately; see the module docstring.
    Silently stays at zero if parec is unavailable, because a missing meter must
    not stop anyone choosing a voice.
    """

    def __init__(self) -> None:
        self.level = 0.0
        self.available = shutil.which("parec") is not None
        self._stop = threading.Event()
        self._proc: subprocess.Popen | None = None
        if self.available:
            threading.Thread(target=self._run, daemon=True).start()

    def _monitor_source(self) -> str | None:
        try:
            sink = subprocess.run(["pactl", "get-default-sink"],
                                  capture_output=True, text=True, timeout=5).stdout.strip()
            return f"{sink}.monitor" if sink else None
        except (OSError, subprocess.SubprocessError):
            return None

    def _run(self) -> None:
        while not self._stop.is_set():
            source = self._monitor_source()
            if not source:
                time.sleep(2)
                continue
            try:
                self._proc = subprocess.Popen(
                    ["parec", f"--device={source}", "--format=s16le",
                     "--rate=8000", "--channels=1", "--latency-msec=50"],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            except OSError:
                self.available = False
                return
            try:
                while not self._stop.is_set():
                    chunk = self._proc.stdout.read(800)  # ~100ms
                    if not chunk:
                        break
                    n = len(chunk) // 2
                    if not n:
                        continue
                    vals = struct.unpack(f"<{n}h", chunk[: n * 2])
                    rms = (sum(v * v for v in vals) / n) ** 0.5 / 32768.0
                    # Decay slowly, rise instantly: a meter that drops as fast as
                    # it climbs reads as flicker rather than as level.
                    self.level = max(rms * 3.0, self.level * 0.7)
            except (OSError, struct.error):
                pass
            finally:
                if self._proc and self._proc.poll() is None:
                    self._proc.kill()
            # The sink changes when a device appears or sleeps; re-resolve it.
            time.sleep(1)

    def stop(self) -> None:
        self._stop.set()
        if self._proc and self._proc.poll() is None:
            self._proc.kill()


# ── audition ────────────────────────────────────────────────────────────────
class Auditioner:
    """Plays a sample through the engine directly, bypassing the daemon.

    Auditioning a voice must not disturb what the daemon is doing, and the voice
    being auditioned is by definition not the configured one, so this drives
    the engine itself rather than asking the daemon to speak.
    """

    def __init__(self) -> None:
        self.procs: list[subprocess.Popen] = []
        self.error = ""
        self.started: float | None = None
        # Time to first SOUND, not to first byte out of the engine. Taken from
        # the level meter, so it measures what actually reached the speakers --
        # which is the number chunk size is being tuned against, and the one a
        # dead sink correctly fails to produce.
        self.first_sound: float | None = None

    def stop(self) -> None:
        for p in reversed(self.procs):
            if p.poll() is None:
                p.kill()
        self.procs = []

    def play(self, voice: str, speed: float, chunk: int, text: str = SAMPLE) -> None:
        self.stop()
        self.error = ""
        self.started = time.monotonic()
        self.first_sound = None
        try:
            tts = subprocess.Popen(
                ["omarchy-speak-kokoro", "--voice", voice, "--speed", f"{speed:.2f}",
                 "--chunk-chars", str(chunk), "--output-raw"],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            play = subprocess.Popen(
                ["aplay", "-q", "-r", "24000", "-f", "S16_LE", "-t", "raw", "-"],
                stdin=tts.stdout, stderr=subprocess.DEVNULL)
            tts.stdout.close()

            def feed() -> None:
                try:
                    tts.stdin.write(text.encode())
                    tts.stdin.close()
                except (BrokenPipeError, ValueError):
                    pass

            threading.Thread(target=feed, daemon=True).start()
            self.procs = [tts, play]
        except OSError as exc:
            self.error = str(exc)


# ── ui ──────────────────────────────────────────────────────────────────────
class App:
    def __init__(self, stdscr, voices: list[str]) -> None:
        self.scr = stdscr
        self.all_voices = voices
        self.langs = ["all"] + sorted({v[0] for v in voices if "_" in v})
        self.lang_i = 0
        self.voice_i = 0
        self.top = 0
        cfg = read_config().get("engines", {}).get("kokoro", {})
        self.current = cfg.get("voice", "af_sarah")
        self.speed = float(cfg.get("speed", 1.0))
        self.chunk = int(cfg.get("chunk_chars", 350))
        try:
            self.scroll_lines = max(1, int(
                read_config().get("ui", {}).get("scroll_lines", DEFAULT_SCROLL_LINES)))
        except (TypeError, ValueError):
            self.scroll_lines = DEFAULT_SCROLL_LINES
        self.saved = f"{self.current} @ {self.speed:.2f}"
        self.long_text = long_sample()
        self.has_reset = ctl_supports("reset")
        self.status = ("enter/l audition   [ ] chunk   w save   r reset   q quit" if self.has_reset
                       else "enter/l audition   [ ] chunk   w save   q quit")
        self.meter = Meter()
        self.audition = Auditioner()
        if self.current in self.visible():
            self.voice_i = self.visible().index(self.current)

    def log(self, message: str) -> None:
        """Append to OMARCHY_SPEAK_UI_LOG, if set. Off unless asked for.

        A curses app cannot print, so reproducing an input bug otherwise means
        guessing. This records what the terminal actually delivered.
        """
        path = os.environ.get("OMARCHY_SPEAK_UI_LOG")
        if not path:
            return
        try:
            with open(path, "a") as fh:
                fh.write(f"{time.monotonic():10.3f}  {message}\n")
        except OSError:
            pass

    def visible(self) -> list[str]:
        lang = self.langs[self.lang_i]
        if lang == "all":
            return self.all_voices
        return [v for v in self.all_voices if v.startswith(lang)]

    def selected(self) -> str:
        vis = self.visible()
        return vis[self.voice_i] if vis else ""

    # -- drawing ---------------------------------------------------------
    def draw(self) -> None:
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 10 or w < 50:
            scr.addstr(0, 0, "terminal too small"[: w - 1])
            scr.refresh()
            return

        scr.addstr(0, 1, "omarchy-speak", curses.A_BOLD)
        scr.addstr(0, max(16, w - len(self.saved) - 8), f"default {self.saved}"[: w - 2],
                   curses.A_DIM)

        # language row
        x = 1
        for i, lang in enumerate(self.langs):
            label = "all" if lang == "all" else LANGS.get(lang, lang)
            cell = f" {label} "
            if x + len(cell) >= w - 1:
                break
            attr = curses.A_REVERSE if i == self.lang_i else curses.A_NORMAL
            scr.addstr(1, x, cell, attr)
            x += len(cell) + 1

        list_h = h - 5
        vis = self.visible()
        if self.voice_i >= len(vis):
            self.voice_i = max(0, len(vis) - 1)
        if self.voice_i < self.top:
            self.top = self.voice_i
        elif self.voice_i >= self.top + list_h:
            self.top = self.voice_i - list_h + 1

        split = min(24, w // 2)
        for row in range(list_h):
            idx = self.top + row
            if idx >= len(vis):
                break
            name = vis[idx]
            mark = "*" if name == self.current else " "
            attr = curses.A_REVERSE if idx == self.voice_i else curses.A_NORMAL
            scr.addstr(3 + row, 1, f"{mark}{name}".ljust(split - 2)[: split - 2], attr)

        # detail pane
        sel = self.selected()
        if sel:
            dx = split + 1
            scr.addstr(3, dx, sel[: w - dx - 1], curses.A_BOLD)
            scr.addstr(4, dx, describe(sel)[: w - dx - 1], curses.A_DIM)
            scr.addstr(6, dx, f"speed  {self.speed:4.2f}   - / +"[: w - dx - 1])
            scr.addstr(7, dx, f"chunk  {self.chunk:4d}   [ / ]"[: w - dx - 1])

            # The number the chunk slider is tuned against. Measured from the
            # level meter, so it is time to actual sound rather than to bytes
            # leaving the engine -- and it stays blank if nothing was audible,
            # which is the honest answer when the sink is swallowing audio.
            first = self.audition.first_sound
            if first is not None:
                scr.addstr(8, dx, f"first sound  {int(first * 1000)} ms"[: w - dx - 1],
                           curses.A_BOLD)
            elif self.audition.started is not None and self.audition.procs:
                scr.addstr(8, dx, "listening..."[: w - dx - 1], curses.A_DIM)

            if sel == self.current:
                scr.addstr(10, dx, "this is the default"[: w - dx - 1], curses.A_DIM)
            if self.audition.error:
                scr.addstr(11, dx, self.audition.error[: w - dx - 1])

        # level meter
        self.draw_meter(h - 2, w)
        scr.addstr(h - 1, 1, self.status[: w - 2], curses.A_DIM)
        scr.refresh()

    def draw_meter(self, row: int, w: int) -> None:
        label = "level " if self.meter.available else "level (parec missing) "
        width = max(0, w - len(label) - 3)
        filled = int(min(1.0, self.meter.level) * width) if self.meter.available else 0
        bar = "█" * filled + "─" * (width - filled)
        try:
            self.scr.addstr(row, 1, label, curses.A_DIM)
            self.scr.addstr(row, 1 + len(label), bar[:width])
        except curses.error:
            pass  # bottom-right cell; harmless

    # -- input -----------------------------------------------------------
    def click(self, y: int, x: int) -> None:
        if y == 1:
            cx = 1
            for i, lang in enumerate(self.langs):
                label = "all" if lang == "all" else LANGS.get(lang, lang)
                cell = len(f" {label} ")
                if cx <= x < cx + cell:
                    self.lang_i, self.voice_i, self.top = i, 0, 0
                    return
                cx += cell + 1
        elif y >= 3:
            idx = self.top + (y - 3)
            if idx < len(self.visible()):
                self.voice_i = idx
                self.audition.play(self.selected(), self.speed, self.chunk)

    def note_first_sound(self) -> None:
        """Record when audio first became audible after an audition started."""
        a = self.audition
        if (a.started is not None and a.first_sound is None
                and self.meter.available and self.meter.level > 0.02):
            a.first_sound = time.monotonic() - a.started

    def run(self) -> None:
        self.scr.timeout(100)  # also paces the meter redraw
        while True:
            self.note_first_sound()
            self.draw()
            try:
                key = self.scr.getch()
            except KeyboardInterrupt:
                break
            if key == -1:
                continue
            if key != curses.KEY_MOUSE:
                self.log(f"key={key} ({curses.keyname(key)!r}) "
                         f"voice_i={self.voice_i} -> {self.selected()}")
            if key in (ord("q"), 27):
                break
            elif key in (curses.KEY_DOWN, ord("j")):
                self.voice_i = min(self.voice_i + 1, max(0, len(self.visible()) - 1))
            elif key in (curses.KEY_UP, ord("k")):
                self.voice_i = max(0, self.voice_i - 1)
            elif key in (curses.KEY_NPAGE,):
                self.voice_i = min(self.voice_i + 10, max(0, len(self.visible()) - 1))
            elif key in (curses.KEY_PPAGE,):
                self.voice_i = max(0, self.voice_i - 10)
            elif key in (curses.KEY_RIGHT, ord("\t")):
                self.lang_i = (self.lang_i + 1) % len(self.langs)
                self.voice_i = self.top = 0
            elif key == curses.KEY_LEFT:
                self.lang_i = (self.lang_i - 1) % len(self.langs)
                self.voice_i = self.top = 0
            elif key in (ord("\n"), curses.KEY_ENTER, ord(" ")):
                self.audition.play(self.selected(), self.speed, self.chunk)
            elif key == ord("l"):
                # Long text, because chunk size is invisible on one sentence.
                self.audition.play(self.selected(), self.speed, self.chunk,
                                   self.long_text)
                self.status = f"long sample ({len(self.long_text)} chars)"
            elif key == ord("["):
                self.chunk = max(CHUNK_MIN, self.chunk - CHUNK_STEP)
            elif key == ord("]"):
                self.chunk = min(CHUNK_MAX, self.chunk + CHUNK_STEP)
            elif key in (ord("+"), ord("=")):
                self.speed = min(2.0, round(self.speed + 0.05, 2))
            elif key in (ord("-"), ord("_")):
                self.speed = max(0.5, round(self.speed - 0.05, 2))
            elif key == ord("w"):
                self.save()
            elif key == ord("r"):
                self.reset()
            elif key == ord("R"):
                self.status = "reloading voices..."
                self.draw()
                self.all_voices = load_voices(refresh=True)
                self.status = "voices reloaded"
            elif key == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                except curses.error:
                    continue
                self.log(f"mouse y={my} x={mx} state=0x{bstate:x} "
                         f"top={self.top} voice_i={self.voice_i}")
                if bstate & curses.BUTTON4_PRESSED:
                    self.voice_i = max(0, self.voice_i - self.scroll_lines)
                elif bstate & getattr(curses, "BUTTON5_PRESSED", 0):
                    self.voice_i = min(self.voice_i + self.scroll_lines,
                                       max(0, len(self.visible()) - 1))
                else:
                    self.click(my, mx)

    def save(self) -> None:
        """Persist the selection, then restart so the daemon picks it up.

        The daemon reads its config once at startup, so a write alone changes
        nothing that anyone can hear.
        """
        voice = self.selected()
        if not voice:
            return
        repaired = False
        for key, value in (("voice", voice), ("speed", self.speed),
                           ("chunk_chars", self.chunk)):
            _, fixed = write_engine_setting(key, value)
            repaired = repaired or fixed
        self.current = voice
        self.saved = f"{voice} @ {self.speed:.2f}"
        self.status = "saved; restarting daemon..."
        self.draw()
        subprocess.run(["systemctl", "--user", "restart", "omarchy-speak"],
                       capture_output=True)
        self.status = (f"saved {voice} @ {self.speed:.2f}, chunk {self.chunk}"
                       + ("  (added missing flags to your speak template)"
                          if repaired else ""))

    def reset(self) -> None:
        """Hand off to `omarchy-speak-ctl reset`, if this ctl has it.

        An older ctl answers an unknown verb with its usage text and a zero
        exit, which would land in the status line looking like a result. Ask
        once whether the verb exists rather than trying to interpret that.
        """
        if not self.has_reset:
            self.status = "reset needs a newer omarchy-speak-ctl"
            return
        self.status = "resetting..."
        self.draw()
        out = subprocess.run(["omarchy-speak-ctl", "reset"], capture_output=True, text=True)
        self.status = (out.stdout.strip().splitlines() or ["reset"])[-1][:120]


def main() -> int:
    voices = load_voices()
    if not voices:
        print("omarchy-speak-ui: could not list voices. Is omarchy-speak-kokoro "
              "installed and its model present?")
        return 1

    def wrapped(stdscr):
        curses.curs_set(0)
        try:
            # BUTTON1_CLICKED only. Registering PRESSED as well delivers TWO
            # events for one physical click, which auditioned twice and made
            # the selection appear to lag. Wheel buttons are named explicitly
            # so scrolling scrolls instead of falling through to the click
            # handler and auditioning whatever the pointer was resting on.
            curses.mousemask(curses.BUTTON1_CLICKED
                             | curses.BUTTON4_PRESSED | curses.BUTTON5_PRESSED)
        except curses.error:
            pass
        app = App(stdscr, voices)
        try:
            app.run()
        finally:
            app.meter.stop()
            app.audition.stop()

    curses.wrapper(wrapped)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
