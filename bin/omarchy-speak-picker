#!/usr/bin/env python3
"""Ask the user where to save an audio file. Prints the chosen path on stdout.

Exits 1 with no output if the dialog is cancelled, so callers can distinguish
"user declined" from "picker unavailable" (exit 2).

Uses GTK4's FileDialog, which routes through xdg-desktop-portal on Wayland and
so honours whatever file manager the desktop is configured to use.
"""

from __future__ import annotations

import sys
from pathlib import Path

try:
    import gi

    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio, Gtk
except (ImportError, ValueError) as exc:
    print(f"picker unavailable: {exc}", file=sys.stderr)
    sys.exit(2)


def main() -> int:
    suggested = sys.argv[1] if len(sys.argv) > 1 else "speak.wav"
    start_dir = sys.argv[2] if len(sys.argv) > 2 else str(Path.home())

    chosen: list[str] = []
    app = Gtk.Application(application_id="org.omarchy.speak.Picker")

    def on_activate(application: Gtk.Application) -> None:
        # A window is needed as the dialog's transient parent, but it is never
        # presented -- the portal renders the chooser itself.
        window = Gtk.ApplicationWindow(application=application)

        dialog = Gtk.FileDialog(
            title="Save speech audio",
            initial_name=Path(suggested).name,
            modal=True,
        )
        folder = Path(start_dir).expanduser()
        if folder.is_dir():
            dialog.set_initial_folder(Gio.File.new_for_path(str(folder)))

        wav = Gtk.FileFilter(name="WAV audio")
        wav.add_pattern("*.wav")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(wav)
        dialog.set_filters(filters)
        dialog.set_default_filter(wav)

        def on_done(source: Gtk.FileDialog, result) -> None:
            try:
                gfile = source.save_finish(result)
                if gfile is not None:
                    chosen.append(gfile.get_path())
            except Exception:
                pass  # dismissed; leave `chosen` empty
            finally:
                window.close()
                application.quit()

        dialog.save(window, None, on_done)

    app.connect("activate", on_activate)
    app.run([])

    if not chosen:
        return 1
    print(chosen[0])
    return 0


if __name__ == "__main__":
    sys.exit(main())
