#!/usr/bin/env python3
"""Ask the user for a file path. Prints the chosen path on stdout.

Two modes:
    omarchy-speak-picker [name] [dir]      save an audio file (default)
    omarchy-speak-picker --open [dir]      open a document to read aloud

Exits 1 with no output if the dialog is cancelled, so callers can distinguish
"user declined" from "picker unavailable" (exit 2).

Uses GTK4's FileDialog, which routes through xdg-desktop-portal on Wayland and
so honours whatever file manager the desktop is configured to use.
"""

from __future__ import annotations

import sys
from pathlib import Path

try:
    import gi

    gi.require_version("Gtk", "4.0")
    from gi.repository import Gio, Gtk
except (ImportError, ValueError) as exc:
    print(f"picker unavailable: {exc}", file=sys.stderr)
    sys.exit(2)


def main() -> int:
    argv = sys.argv[1:]
    opening = bool(argv) and argv[0] == "--open"
    if opening:
        argv = argv[1:]
        suggested = ""
        start_dir = argv[0] if argv else str(Path.home())
    else:
        suggested = argv[0] if argv else "speak.wav"
        start_dir = argv[1] if len(argv) > 1 else str(Path.home())

    chosen: list[str] = []
    app = Gtk.Application(application_id="org.omarchy.speak.Picker")

    def on_activate(application: Gtk.Application) -> None:
        # A window is needed as the dialog's transient parent, but it is never
        # presented -- the portal renders the chooser itself.
        window = Gtk.ApplicationWindow(application=application)

        dialog = Gtk.FileDialog(
            title="Read aloud" if opening else "Save speech audio",
            modal=True,
        )
        if not opening:
            dialog.set_initial_name(Path(suggested).name)
        folder = Path(start_dir).expanduser()
        if folder.is_dir():
            dialog.set_initial_folder(Gio.File.new_for_path(str(folder)))

        filters = Gio.ListStore.new(Gtk.FileFilter)
        if opening:
            docs = Gtk.FileFilter(name="Text and Markdown")
            for pattern in ("*.txt", "*.md", "*.markdown", "*.text"):
                docs.add_pattern(pattern)
            filters.append(docs)
            everything = Gtk.FileFilter(name="All files")
            everything.add_pattern("*")
            filters.append(everything)
            dialog.set_filters(filters)
            dialog.set_default_filter(docs)
        else:
            wav = Gtk.FileFilter(name="WAV audio")
            wav.add_pattern("*.wav")
            filters.append(wav)
            dialog.set_filters(filters)
            dialog.set_default_filter(wav)

        def on_done(source: Gtk.FileDialog, result) -> None:
            try:
                gfile = (source.open_finish(result) if opening
                         else source.save_finish(result))
                if gfile is not None:
                    chosen.append(gfile.get_path())
            except Exception:
                pass  # dismissed; leave `chosen` empty
            finally:
                window.close()
                application.quit()

        if opening:
            dialog.open(window, None, on_done)
        else:
            dialog.save(window, None, on_done)

    app.connect("activate", on_activate)
    app.run([])

    if not chosen:
        return 1
    print(chosen[0])
    return 0


if __name__ == "__main__":
    sys.exit(main())
