#!/usr/bin/env python3
"""Thin CLI over kokoro-onnx, shaped so the daemon can drive it as a template.

Reads text on stdin. Streams raw int16 PCM to stdout with --output-raw, or
writes a wav with --output-file. Streaming emits audio per sentence, so
playback starts long before a long passage finishes synthesising.

Loading kokoro's 311MB model costs ~2s, which is painful to pay on every
utterance. Run `--serve` to keep a warm worker holding the model on a unix
socket; the CLI then connects to it automatically and starts synthesising
immediately. With no worker running it loads the model in-process as before,
so the socket is an optimisation and never a requirement.

Runs on the GPU where onnxruntime-gpu and a usable CUDA device are present,
and on the CPU otherwise; --provider forces the choice either way.
"""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import re
import socket
import sys
import threading
from pathlib import Path

DATA = Path(os.environ.get(
    "OMARCHY_SPEAK_KOKORO_DIR", "~/.local/share/omarchy-speak/models"
)).expanduser()

SOCKET_PATH = Path(os.environ.get(
    "OMARCHY_SPEAK_KOKORO_SOCK",
    f"{os.environ.get('XDG_RUNTIME_DIR', '/tmp')}/omarchy-speak-kokoro.sock",
))

SAMPLE_RATE = 24000  # kokoro's native rate; keep the player's -r in step
CHUNK = 8192


# ── model ────────────────────────────────────────────────────────────────
def resolve_provider(preference: str) -> str:
    """Pick an onnxruntime execution provider.

    onnxruntime-gpu advertises CUDAExecutionProvider whenever the GPU build is
    installed, but CUDA and cuDNN arrive as separate pip packages that are not
    on the loader path — so "advertised" is not "loadable". preload_dlls()
    brings them in; without it the session silently lands back on the CPU.
    """
    import onnxruntime as rt

    if preference == "cpu":
        return "CPUExecutionProvider"

    try:
        rt.preload_dlls()
    except Exception:  # noqa: BLE001 - an old runtime without the helper
        pass

    if "CUDAExecutionProvider" in rt.get_available_providers():
        return "CUDAExecutionProvider"
    if preference == "cuda":
        sys.exit("kokoro: --provider cuda, but onnxruntime has no CUDA provider\n"
                 "install it with: pip install 'onnxruntime-gpu[cuda,cudnn]'")
    return "CPUExecutionProvider"


def build(model_name: str, voices_name: str, provider: str = "auto"):
    from kokoro_onnx import Kokoro

    model, voices = DATA / model_name, DATA / voices_name
    for path in (model, voices):
        if not path.exists():
            sys.exit(f"kokoro: missing {path}\n"
                     f"download the model files into {DATA}")

    chosen = resolve_provider(provider)
    os.environ["ONNX_PROVIDER"] = chosen  # kokoro_onnx reads the provider from here
    try:
        return Kokoro(str(model), str(voices))
    except Exception as exc:  # noqa: BLE001
        # A GPU that enumerates but cannot build a session (driver mismatch, an
        # eGPU unplugged since boot, VRAM exhausted) must not cost us the voice
        # entirely — the CPU path is slower but always there.
        if chosen == "CPUExecutionProvider" or provider == "cuda":
            raise
        print(f"kokoro: GPU init failed ({exc}); using CPU", file=sys.stderr)
        os.environ["ONNX_PROVIDER"] = "CPUExecutionProvider"
        return Kokoro(str(model), str(voices))


# The model's context is 510 phonemes. kokoro_onnx truncates to exactly that and
# then indexes the voice array at len(tokens) -- index 510 of 510 -- so text over
# the cap does not degrade, it raises IndexError inside an asyncio task whose
# exception nobody retrieves. The utterance simply never arrives.
#
# Chunking below the cap avoids it entirely, and pays twice: the first chunk
# starts playing while the rest is still being synthesised, which is what makes
# long passages start promptly instead of after the whole text is rendered.
#
# 350 characters is deliberately conservative. English runs a little under one
# phoneme per character, so the cap sits somewhere north of 500 characters, but
# it moves with the text -- numbers, punctuation and stress marks all shift the
# ratio -- and being wrong here is a silent failure rather than a slow one.
MAX_CHUNK_CHARS = 350


def chunk_text(text: str, limit: int = MAX_CHUNK_CHARS) -> list[str]:
    """Split text into pieces that fit the model's phoneme window.

    Splits on sentence boundaries so the seams fall where a reader would pause
    anyway. A single sentence longer than the limit is broken at the last space
    that fits, which is audible but rare and still better than losing it.
    """
    text = " ".join(text.split())
    if not text:
        return []
    if len(text) <= limit:
        return [text]

    chunks: list[str] = []
    current = ""
    for sentence in re.split(r"(?<=[.!?])\s+", text):
        while len(sentence) > limit:
            cut = sentence.rfind(" ", 0, limit)
            if cut <= 0:
                cut = limit  # no space to break on; hard cut rather than fail
            if current:
                chunks.append(current)
                current = ""
            chunks.append(sentence[:cut].strip())
            sentence = sentence[cut:].strip()
        if not sentence:
            continue
        if not current:
            current = sentence
        elif len(current) + 1 + len(sentence) <= limit:
            current += " " + sentence
        else:
            chunks.append(current)
            current = sentence
    if current:
        chunks.append(current)
    return chunks


def to_pcm16(samples) -> bytes:
    import numpy as np

    return (np.clip(samples, -1.0, 1.0) * 32767).astype("<i2").tobytes()


async def _stream(kokoro, req: dict, write) -> None:
    """Synthesise sentence by sentence, handing each chunk to `write`.

    `write` raises BrokenPipeError once the consumer is gone, which is how an
    interrupted utterance stops the model mid-passage instead of finishing it.
    """
    for chunk in chunk_text(req["text"], req.get("chunk_chars") or MAX_CHUNK_CHARS):
        stream = kokoro.create_stream(
            chunk, voice=req["voice"], speed=req["speed"], lang=req["lang"]
        )
        async for samples, _rate in stream:
            write(to_pcm16(samples))


def synth_to_file(kokoro, req: dict) -> None:
    import soundfile as sf

    import numpy as np

    parts, rate = [], 24000
    for chunk in chunk_text(req["text"], req.get("chunk_chars") or MAX_CHUNK_CHARS):
        samples, rate = kokoro.create(
            chunk, voice=req["voice"], speed=req["speed"], lang=req["lang"]
        )
        parts.append(samples)
    if not parts:
        raise ValueError("nothing to synthesise")
    sf.write(req["output_file"], parts[0] if len(parts) == 1 else np.concatenate(parts), rate)


# ── warm worker ──────────────────────────────────────────────────────────
def serve(args) -> int:
    kokoro = build(args.model, args.voices, args.provider)
    lock = threading.Lock()  # one onnx session; serialise callers

    SOCKET_PATH.parent.mkdir(parents=True, exist_ok=True)
    if SOCKET_PATH.exists():
        SOCKET_PATH.unlink()  # stale socket from an unclean exit
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCKET_PATH))
    SOCKET_PATH.chmod(0o600)
    server.listen(8)
    ep = kokoro.sess.get_providers()[0].replace("ExecutionProvider", "")
    print(f"kokoro worker ready on {SOCKET_PATH} [{ep}]", flush=True)

    def handle(conn: socket.socket) -> None:
        with conn:
            try:
                buf = b""
                while not buf.endswith(b"\n"):
                    part = conn.recv(4096)
                    if not part:
                        return
                    buf += part
                req = json.loads(buf)

                with lock:
                    if req.get("output_file"):
                        synth_to_file(kokoro, req)
                        conn.sendall(b'{"ok":true}\n')
                    else:
                        asyncio.run(_stream(kokoro, req, conn.sendall))
            except (BrokenPipeError, ConnectionResetError):
                pass  # client interrupted; drop this utterance
            except Exception as exc:  # noqa: BLE001 - report, never die
                try:
                    conn.sendall(
                        json.dumps({"ok": False, "error": str(exc)}).encode() + b"\n"
                    )
                except OSError:
                    pass

    try:
        while True:
            conn, _ = server.accept()
            threading.Thread(target=handle, args=(conn,), daemon=True).start()
    except KeyboardInterrupt:
        pass
    finally:
        server.close()
        SOCKET_PATH.unlink(missing_ok=True)
    return 0


def try_worker(req: dict) -> bool:
    """Run the request against the warm worker. False if it isn't available."""
    if not SOCKET_PATH.exists():
        return False
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.settimeout(5)
        conn.connect(str(SOCKET_PATH))
    except OSError:
        return False  # stale socket or worker gone; caller falls back

    with conn:
        conn.sendall(json.dumps(req).encode() + b"\n")
        conn.settimeout(None)
        if req.get("output_file"):
            reply = json.loads(conn.recv(4096) or b"{}")
            if not reply.get("ok"):
                sys.exit(f"kokoro: {reply.get('error', 'worker failed')}")
            return True

        out = sys.stdout.buffer
        while True:
            chunk = conn.recv(CHUNK)
            if not chunk:
                break
            # A leading '{' means the worker reported an error rather than audio.
            if chunk.startswith(b'{"ok": false') or chunk.startswith(b'{"ok":false'):
                sys.exit(f"kokoro: {json.loads(chunk).get('error')}")
            try:
                out.write(chunk)
                out.flush()
            except BrokenPipeError:
                return True  # player exited; stop cleanly
    return True


# ── entry point ──────────────────────────────────────────────────────────
def main() -> int:
    ap = argparse.ArgumentParser(prog="omarchy-speak-kokoro")
    ap.add_argument("-v", "--voice", default="af_sarah")
    ap.add_argument("-s", "--speed", type=float, default=1.0)
    # Chunk size sets time-to-first-audio: the first chunk is the wait before
    # any sound. Measured on a CPU-only i7-8550U, rendering costs roughly 1.2s
    # fixed plus 30ms per character, so 350 characters is ~11s of silence there
    # and 150 is ~4s. A machine with a GPU does not notice; a slow one does, and
    # the right value is therefore a property of the machine, not of this file.
    ap.add_argument("--chunk-chars", type=int, default=MAX_CHUNK_CHARS,
                    dest="chunk_chars",
                    help=f"characters per synthesis chunk (default {MAX_CHUNK_CHARS})")
    ap.add_argument("-l", "--lang", default="en-us")
    ap.add_argument("-f", "--output-file", "--output_file", dest="output_file")
    ap.add_argument("--output-raw", "--output_raw", action="store_true",
                    dest="output_raw")
    ap.add_argument("--model", default="kokoro-v1.0.onnx")
    ap.add_argument("--voices", default="voices-v1.0.bin")
    ap.add_argument("--list-voices", action="store_true")
    ap.add_argument("--serve", action="store_true",
                    help="run as a warm worker holding the model in memory")
    ap.add_argument("--provider", choices=("auto", "cuda", "cpu"), default="auto",
                    help="onnxruntime execution provider (default: GPU if usable)")
    args = ap.parse_args()

    if args.serve:
        return serve(args)
    if args.list_voices:
        print("\n".join(sorted(
            build(args.model, args.voices, args.provider).get_voices())))
        return 0

    text = sys.stdin.read().strip()
    if not text:
        sys.exit("kokoro: no text on stdin")
    if not args.output_raw and not args.output_file:
        sys.exit("kokoro: need --output-file or --output-raw")

    req = {
        "text": text, "voice": args.voice, "speed": args.speed,
        "lang": args.lang, "output_file": args.output_file,
        "chunk_chars": args.chunk_chars,
    }

    if try_worker(req):
        return 0

    # No worker: load the model here and do it ourselves.
    kokoro = build(args.model, args.voices, args.provider)
    if args.output_file:
        synth_to_file(kokoro, req)
        return 0

    out = sys.stdout.buffer

    def write(data: bytes) -> None:
        out.write(data)
        out.flush()

    try:
        asyncio.run(_stream(kokoro, req, write))
    except BrokenPipeError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
