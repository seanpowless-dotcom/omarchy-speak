#!/bin/bash
# omarchy-speak-ctl — thin client for the omarchy-speak daemon.
# Designed to be bound to Hyprland keys. Reports via notifications.

set -uo pipefail

HOST="${OMARCHY_SPEAK_HOST:-127.0.0.1}"
PORT="${OMARCHY_SPEAK_PORT:-8765}"
BASE="http://$HOST:$PORT"

notify() {
  command -v notify-send >/dev/null && notify-send -a "omarchy-speak" -t 2500 "$@" || echo "$*"
}

# POST to the daemon; on success echo the body, on failure notify and exit 1.
post() {
  local path="$1" body="${2:-{\}}" response code
  response=$(curl -sS -m 300 -w '\n%{http_code}' \
    -H 'Content-Type: application/json' -d "$body" "$BASE$path" 2>&1) || {
    notify "Speak: daemon not reachable" "Is omarchy-speak running?"
    exit 1
  }
  code=$(tail -n1 <<<"$response")
  body=$(sed '$d' <<<"$response")
  if [[ "$code" != 200 ]]; then
    notify "Speak: error" "$(python3 -c 'import json,sys;print(json.load(sys.stdin).get("error","?"))' <<<"$body" 2>/dev/null || echo "$body")"
    exit 1
  fi
  echo "$body"
}

# Build a JSON body from optional engine / path arguments.
json_body() {
  local engine="${1:-}" path="${2:-}"
  python3 -c '
import json, sys
engine, path = sys.argv[1], sys.argv[2]
body = {}
if engine: body["engine"] = engine
if path:   body["path"] = path
print(json.dumps(body))
' "$engine" "$path"
}

usage() {
  cat <<'USAGE'
omarchy-speak-ctl <command> [engine] [path]

  selection [engine]     speak the highlighted text (primary selection)
  clipboard [engine]     speak the clipboard
  say <text> [engine]    speak literal text
  playpause [engine]     pause, resume, or start on the selection
  toggle [engine]        stop if speaking, else speak the selection
  next                   skip to the next clip in the queue
  prev                   restart this clip, or step back to the previous one
  stop                   stop playback and clear the queue
  enqueue [engine]       add the selection to the end of the queue
  enqueue-clip [engine]  add the clipboard to the end of the queue
  queue                  list the queue
  clear                  drop everything except what is playing
  save [engine] [path]   render the selection to a file
  status                 report daemon state
  reset                  snapshot diagnostics, then restart the engine and daemon

Engines come from the daemon config; omit to use the default.
USAGE
}

cmd="${1:-}"
case "$cmd" in
  selection) post /speak/selection "$(json_body "${2:-}")" >/dev/null ;;
  clipboard) post /speak/clipboard "$(json_body "${2:-}")" >/dev/null ;;
  toggle)
    out=$(post /toggle "$(json_body "${2:-}")")
    [[ "$out" == *stopped* ]] && notify "Speak: stopped"
    ;;
  playpause)
    # Resuming needs no toast — the audio coming back says it. A pause is
    # worth one, so a silent daemon is not mistaken for a dead one.
    out=$(post /playpause "$(json_body "${2:-}")")
    [[ "$out" == *'"action": "paused"'* ]] && notify "Speak: paused"
    ;;
  next|prev)
    out=$(post "/$cmd")
    python3 -c '
import json, sys
d = json.load(sys.stdin)
cur = d.get("current")
if not d.get("moved"):
    print("Speak: end of queue" if sys.argv[1] == "next" else "Speak: start of queue")
elif cur:
    print("Speak: " + cur)
' "$cmd" <<<"$out" | while read -r line; do notify "$line"; done
    ;;
  stop)
    out=$(post /stop)
    [[ "$out" == *'"stopped": true'* ]] && notify "Speak: stopped"
    ;;
  enqueue|enqueue-clip)
    path=/queue/selection
    [[ "$cmd" == enqueue-clip ]] && path=/queue/clipboard
    out=$(post "$path" "$(json_body "${2:-}")")
    notify "$(python3 -c '
import json, sys
d = json.load(sys.stdin)
print("Speak: playing" if d.get("started") else "Speak: queued (%d)" % d["queued"])
' <<<"$out")"
    ;;
  queue)
    curl -sS -m 5 "$BASE/queue" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d["items"]:
    print("queue empty")
for it in d["items"]:
    mark = "*" if it["current"] else " "
    print("%s %2d  [%s]  %s" % (mark, it["n"], it["engine"], it["text"]))
' || { notify "Speak: daemon not running"; exit 1; }
    ;;
  clear)
    out=$(post /queue/clear)
    notify "Speak: queue cleared" \
      "$(python3 -c 'import json,sys;print("%d dropped" % json.load(sys.stdin)["dropped"])' <<<"$out")"
    ;;
  say)
    [[ -z "${2:-}" ]] && { usage; exit 1; }
    body=$(python3 -c '
import json, sys
body = {"text": sys.argv[1]}
if len(sys.argv) > 2 and sys.argv[2]: body["engine"] = sys.argv[2]
print(json.dumps(body))
' "$2" "${3:-}")
    post /speak "$body" >/dev/null
    ;;
  save)
    engine="${2:-}"; dest="${3:-}"

    # No explicit path: ask, unless the config says to use the default location.
    if [[ -z "$dest" ]]; then
      prompt=$(curl -sS -m 5 "$BASE/config" 2>/dev/null \
        | python3 -c 'import json,sys;print(json.load(sys.stdin).get("save_prompt", True))' 2>/dev/null)
      if [[ "$prompt" == "True" ]]; then
        suggested="speak-$(date +%Y%m%d-%H%M%S).wav"
        start=$(curl -sS -m 5 "$BASE/config" 2>/dev/null \
          | python3 -c 'import json,sys,os;print(os.path.expanduser(json.load(sys.stdin).get("save_dir","~")))' 2>/dev/null)
        dest=$(omarchy-speak-picker "$suggested" "${start:-$HOME}")
        case $? in
          1) exit 0 ;;                      # user cancelled -- not an error
          2) dest="" ;;                     # no picker available; fall through
        esac
      fi
    fi

    body=$(python3 -c '
import json, sys
body = {"source": "primary"}
if sys.argv[1]: body["engine"] = sys.argv[1]
if sys.argv[2]: body["path"] = sys.argv[2]
print(json.dumps(body))
' "$engine" "$dest")
    out=$(post /save "$body")
    saved=$(python3 -c 'import json,sys;print(json.load(sys.stdin)["path"])' <<<"$out")
    notify "Speak: saved" "$saved"
    ;;
  status)
    curl -sS -m 5 "$BASE/status" | python3 -m json.tool 2>/dev/null \
      || { notify "Speak: daemon not running"; exit 1; }
    ;;
  reset)
    # Snapshot BEFORE restarting. A reset that fixes the problem and destroys
    # the evidence leaves nothing to report, and the failures worth reporting
    # here are the ones that look identical from outside: a wedged engine, an
    # audio sink that accepts audio without playing it, and a daemon that
    # believes it is still speaking. Each of those is one line below.
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-speak"
    mkdir -p "$state_dir"
    report="$state_dir/last-reset.md"

    {
      echo "# omarchy-speak reset — $(date -Is)"
      echo
      echo '## Daemon'
      echo '```'
      curl -sS -m 5 "$BASE/status" 2>&1 | python3 -m json.tool 2>/dev/null || echo "not reachable"
      curl -sS -m 5 "$BASE/config" 2>&1 | python3 -m json.tool 2>/dev/null
      echo '```'

      echo
      echo '## Engine liveness'
      echo '```'
      # The single most diagnostic line here. A wedged kokoro worker blocks at
      # ~0% CPU and is otherwise indistinguishable from one that is merely slow;
      # a short timeout tells them apart in one number.
      for eng in $(curl -sS -m 5 "$BASE/engines" 2>/dev/null \
                   | python3 -c 'import json,sys;print(" ".join(json.load(sys.stdin)["engines"]))' 2>/dev/null); do
        start=$(date +%s%N)
        if curl -sS -m 12 -H 'Content-Type: application/json' \
             -d "{\"engine\":\"$eng\",\"source\":\"text\",\"text\":\"test\",\"path\":\"$state_dir/probe.wav\"}" \
             "$BASE/save" >/dev/null 2>&1; then
          echo "$eng: OK ($(( ($(date +%s%N) - start) / 1000000 )) ms)"
        else
          echo "$eng: FAILED or timed out after $(( ($(date +%s%N) - start) / 1000000 )) ms"
        fi
        rm -f "$state_dir/probe.wav"
      done
      echo '```'

      echo
      echo '## Audio sink'
      echo '```'
      # A Bluetooth speaker that is connected but asleep accepts audio and never
      # plays it, which reads exactly like a broken daemon. Report the sink;
      # do not try to guess whether it is at fault.
      command -v wpctl >/dev/null && wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' || echo "wpctl unavailable"
      command -v bluetoothctl >/dev/null && bluetoothctl devices Connected 2>/dev/null
      echo '```'

      echo
      echo '## Journal'
      echo '```'
      journalctl --user -u omarchy-speak -u omarchy-speak-kokoro -n 40 --no-pager 2>&1 | tail -40
      echo '```'

      echo
      echo '## Versions'
      echo '```'
      echo "omarchy-speak: $(command -v omarchy-speak)"
      for u in omarchy-speak omarchy-speak-kokoro; do
        echo "$u: $(systemctl --user is-active $u 2>&1), restarts=$(systemctl --user show $u -p NRestarts --value 2>/dev/null)"
      done
      uname -sr; . /etc/os-release 2>/dev/null && echo "$PRETTY_NAME"
      echo '```'
    } >"$report" 2>&1

    echo "Wrote $report"
    echo "Restarting..."
    systemctl --user restart omarchy-speak-kokoro 2>/dev/null
    systemctl --user restart omarchy-speak 2>/dev/null
    sleep 2
    if curl -sS -m 5 "$BASE/status" >/dev/null 2>&1; then
      notify "Speak: reset" "Daemon back up. Report: $report"
      echo "Daemon is answering again."
    else
      notify "Speak: reset" "Daemon did NOT come back — see $report"
      echo "Daemon is NOT answering. See $report" >&2
      exit 1
    fi
    ;;
  ""|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
