{
  "host": "127.0.0.1",
  "port": 8765,
  "default_engine": "piper",
  "save_dir": "~/Audio/speak",
  "max_chars": 20000,
  "engines": {
    "piper": {
      "mode": "stream",
      "model": "~/.local/share/piper/voices/en_US-lessac-medium.onnx",
      "speak": [
        "piper",
        "--model",
        "{model}",
        "--output-raw"
      ],
      "save": [
        "piper",
        "--model",
        "{model}",
        "--output-file",
        "{out}"
      ],
      "play": [
        "aplay",
        "-q",
        "-r",
        "22050",
        "-f",
        "S16_LE",
        "-t",
        "raw",
        "-"
      ]
    },
    "kokoro": {
      "mode": "stream",
      "voice": "af_sarah",
      "speak": [
        "omarchy-speak-kokoro",
        "--voice",
        "{voice}",
        "--output-raw"
      ],
      "save": [
        "omarchy-speak-kokoro",
        "--voice",
        "{voice}",
        "--output-file",
        "{out}"
      ],
      "play": [
        "aplay",
        "-q",
        "-r",
        "24000",
        "-f",
        "S16_LE",
        "-t",
        "raw",
        "-"
      ]
    }
  }
}
