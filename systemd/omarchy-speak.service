[Unit]
Description=omarchy-speak TTS daemon
Documentation=https://github.com/YOURNAME/omarchy-speak
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Resolve the binary at start so one unit serves both a ~/.local
# install and a packaged /usr/bin one.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env sh -c 'exec "$(command -v omarchy-speak)"'
Restart=on-failure
RestartSec=2
# The daemon shells out to wl-paste, so it needs the compositor's environment.
# `systemctl --user import-environment` at login covers WAYLAND_DISPLAY.

[Install]
WantedBy=graphical-session.target
